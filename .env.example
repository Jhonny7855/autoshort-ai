# AUTOSHORT AI configuration
# Copy this file to .env and edit. Every value below is optional: the app runs
# with sensible defaults and needs no paid API keys.

# --- Server ---------------------------------------------------------------
AUTOSHORT_HOST=127.0.0.1
AUTOSHORT_PORT=8787
# Public/base URL used to build the Google OAuth redirect. Must match what you
# register in Google Cloud Console.
AUTOSHORT_BASE_URL=http://127.0.0.1:8787
AUTOSHORT_WEB_DEV_URL=http://127.0.0.1:5273

# --- Storage --------------------------------------------------------------
AUTOSHORT_DATA_DIR=data
AUTOSHORT_DB_PATH=data/autoshort.db
AUTOSHORT_SECRET_FILE=data/secret.key
AUTOSHORT_MAX_UPLOAD_MB=512
AUTOSHORT_LOG_RETENTION_DAYS=30
AUTOSHORT_RENDER_WORKERS=1
AUTOSHORT_SESSION_DAYS=30
AUTOSHORT_ALLOWED_ORIGINS=http://127.0.0.1:5273,http://localhost:5273,http://127.0.0.1:8787,http://localhost:8787

# --- Local AI -------------------------------------------------------------
# Any Ollama-compatible endpoint. No cloud key required.
OLLAMA_URL=http://127.0.0.1:11434

# --- Optional image generation -------------------------------------------
# Leave blank to use the built-in procedural art renderer.
COMFYUI_URL=

# --- YouTube upload (optional) -------------------------------------------
# AUTOSHORT AI publishes locally by default: finished Shorts land in
# data/publishing/ with title, description and hashtags ready to paste into
# YouTube Studio. Nothing below is required.
#
# To enable optional API upload, create an OAuth 2.0 Client (type: Web
# application) in Google Cloud Console, enable "YouTube Data API v3", then add
# this exact redirect URI: http://127.0.0.1:8787/api/auth/google/callback
# Leave blank for local-only mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTOSHORT_PUBLISH_MODE=local

# --- Tools ----------------------------------------------------------------
# Leave blank to auto-detect from PATH.
FFMPEG_BIN=
FFPROBE_BIN=
